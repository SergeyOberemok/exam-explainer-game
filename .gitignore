# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment to ignore Addressables / streaming build output
# /[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
# /[Aa]ssets/[Ss]treamingAssets/aa*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE folders
/.idea/
/.vs/
/.vscode/
.history/
*.swp

# Visual Studio / Rider / MSBuild generated project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Unity-generated crash / debug files
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Gradle / Android Studio
.gradle/
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*.tmp

# Test results / coverage
/[Cc]ode[Cc]overage/
TestResults/
*.log

# Unity AI Assistant / local tooling
/[Aa]ssets/[Aa]ssistant/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local secrets
.env

# Claude Code local settings
.claude/settings.local.json
