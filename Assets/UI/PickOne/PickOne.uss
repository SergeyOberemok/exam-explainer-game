:root {
    --ink: #2a170f;
    --brand: #a83223;
    --brand-dark: #8c2a1d;
    --page: #fff8f6;
    --peach: #ffe9e2;
    --peach-2: #ffe2d8;
    --cream: #fff1ec;
    --mint: #b8eeda;
    --mint-ink: #002018;
    --mint-soft: #e9faf3;
    --sand: #ffdead;
    --sand-ink: #281900;
    --gold: #fdbe50;
    --muted: #58413d;
    --latin: #326556;
    --heading: #1a0f0a;
    --pink: #ffdad4;
    --pink-ink: #410100;
    --pink-soft: #fff0ee;
    --gold-soft: #fff4dc;
    --white: #ffffff;
}

/* ---------- resets for theme defaults ---------- */

.unity-label {
    margin: 0;
    padding: 0;
}

/* ---------- shared building blocks ---------- */

.is-hidden {
    display: none;
}

/* Hard offset shadow: wrapper holds an absolute .brutal__shadow sibling translated under the box. */
.brutal {
    position: relative;
}

.brutal__shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ink);
}

.brutal--s3 > .brutal__shadow {
    translate: 3px 3px;
}

.brutal--s4 > .brutal__shadow {
    translate: 4px 4px;
}

.box {
    flex-grow: 1;
    background-color: var(--white);
    border-width: 2px;
    border-color: var(--ink);
}

.icon {
    flex-shrink: 0;
}

.icon--logo { width: 21.7px; height: 20.66px; background-image: url("project://database/Assets/UI/PickOne/Icons/logo.svg"); }
.icon--coin { width: 15px; height: 15px; background-image: url("project://database/Assets/UI/PickOne/Icons/coin.svg"); }
.icon--timer { width: 13.5px; height: 15.75px; background-image: url("project://database/Assets/UI/PickOne/Icons/timer.svg"); }
.icon--sound { width: 13.5px; height: 13.125px; background-image: url("project://database/Assets/UI/PickOne/Icons/sound.svg"); }
.icon--pause { width: 10.5px; height: 10.5px; background-image: url("project://database/Assets/UI/PickOne/Icons/pause.svg"); }
.icon--profile { width: 12px; height: 12px; background-image: url("project://database/Assets/UI/PickOne/Icons/profile.svg"); }
.icon--exit { width: 12px; height: 12px; background-image: url("project://database/Assets/UI/PickOne/Icons/exit.svg"); }
.icon--search { width: 13px; height: 13px; background-image: url("project://database/Assets/UI/PickOne/Icons/search.svg"); }
.icon--select { width: 13px; height: 15.75px; background-image: url("project://database/Assets/UI/PickOne/Icons/select-pointer-dark.svg"); }
.icon--heart { width: 15px; height: 13.76px; background-image: url("project://database/Assets/UI/PickOne/Icons/heart-full.svg"); }
.icon--heart-used { background-image: url("project://database/Assets/UI/PickOne/Icons/heart.svg"); }
.icon--streak { width: 11.33px; height: 13.46px; background-image: url("project://database/Assets/UI/PickOne/Icons/streak.svg"); }
.icon--fifty { width: 16.5px; height: 10.5px; background-image: url("project://database/Assets/UI/PickOne/Icons/fifty.svg"); }
.icon--freeze { width: 15px; height: 15px; background-image: url("project://database/Assets/UI/PickOne/Icons/freeze.svg"); }
.icon--codex { width: 16.5px; height: 14.63px; background-image: url("project://database/Assets/UI/PickOne/Icons/codex.svg"); }

/* Small chip; .chip--raised adds the 1px offset shadow as a thicker right/bottom border. */
.chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 9px;
    border-width: 1px;
    border-color: var(--ink);
    background-color: var(--peach);
}

.chip--raised {
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.chip--mint { background-color: var(--mint); }
.chip--sand { background-color: var(--sand); }
.chip--gold { background-color: var(--gold); }
.chip--peach-2 { background-color: var(--peach-2); }
.chip--pink { background-color: var(--pink); }
.chip--dark { background-color: var(--ink); }

.chip__text {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
}

.chip--mint > .chip__text { color: var(--mint-ink); }
.chip--sand > .chip__text { color: var(--sand-ink); }
.chip--pink > .chip__text { color: var(--pink-ink); }
.chip--dark > .chip__text { color: var(--white); }

.chip > .icon {
    margin-right: 5px;
}

/* ---------- screen ---------- */

.screen {
    flex-grow: 1;
    background-color: var(--page);
}

/* ---------- header ---------- */

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 66px;
    padding: 0 24px;
    background-color: var(--white);
    border-bottom-width: 2px;
    border-color: var(--ink);
}

.header__group {
    flex-direction: row;
    align-items: center;
}

.logo {
    flex-direction: row;
    align-items: center;
    margin-right: 24px;
}

.logo__text {
    margin-left: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: -0.55px;
    color: var(--brand);
}

.nav {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--ink);
}

.nav-link {
    padding: 4px 14px;
    margin-right: 6px;
}

.nav-link--active {
    padding: 5px 15px;
    background-color: var(--brand);
    border-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--ink);
}

.nav-link__text {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--muted);
}

.nav-link--active > .nav-link__text {
    color: var(--white);
}

.progress {
    flex-direction: row;
    align-items: center;
    width: 250px;
    margin-right: 16px;
}

.progress__label {
    margin-right: 6px;
    font-size: 11px;
    letter-spacing: 0.55px;
    color: var(--muted);
}

.progress__percent {
    width: 32px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.55px;
    color: var(--brand);
    align-self: flex-start;
}

.progress__bar {
    flex-grow: 1;
    height: 10px;
    margin-left: 12px;
    overflow: hidden;
    background-color: var(--white);
    border-width: 1px;
    border-color: var(--ink);
}

.progress__fill {
    height: 100%;
    width: 0;
    background-color: var(--brand);
}

.stat {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    margin-right: 16px;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--ink);
}

.stat--gold {
    background-color: var(--gold);
}

.stat__text {
    margin-left: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--ink);
}

.header__tools {
    flex-direction: row;
    align-items: center;
    padding-left: 13px;
    margin-right: 16px;
    border-left-width: 1px;
    border-color: rgba(224, 191, 186, 0.4);
}

.icon-button {
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
}

.icon-button--spaced {
    margin-left: 6px;
}

.icon-button--brand {
    background-color: var(--brand);
}

.icon-button--exit {
    margin-left: 12px;
}

.icon-button--exit:hover,
.icon-button--search:hover,
.icon-button--close:hover {
    background-color: var(--gold);
}

/* ---------- main ---------- */

.main {
    flex-grow: 1;
    padding: 14px 32px;
}

/* ---------- question section ---------- */

/* The question takes the room the cards don't need: their answers are short. */
.question-section {
    flex-grow: 1;
    flex-shrink: 1;
}

.question {
    flex-grow: 1;
    min-height: 300px;
    padding: 16px 26px;
    overflow: hidden;
}

.question__strip {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 4px;
}

.question__meta {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.question__meta > .chip {
    padding: 3px 11px;
    margin-right: 8px;
}

.question__meta > .chip > .chip__text {
    letter-spacing: 0.55px;
}

/* The long, low-value chips (the section, the dev id) shorten with an ellipsis so the others and the panel
   tabs stay whole; runtime panels show no tooltips, so a cut chip would lose its text. */
.question__meta > .meta-chip--shrink {
    flex-shrink: 1;
    min-width: 40px;
    overflow: hidden;
}

.question__meta > .meta-chip--shrink > .chip__text {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.question__scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.question__text {
    /* Verdana is wide and sturdy already, so regular weight reads better than bold for long text.
       The asset is a Dynamic OS font (nothing shipped); the default font covers systems without Verdana. */
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Verdana%20SDF.asset");
    font-size: 17px;
    -unity-font-style: normal;
    letter-spacing: 0.2px;
    word-spacing: 1px;
    color: var(--heading);
    white-space: normal;
}

/* The briefing, above the ask: one row per fact (QuestionPartsView), typed one after another (TypingSequence). */
.question-parts {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.question-part {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.question-part--pending {
    opacity: 0;
    translate: 0 6px;
}

/* Icons for the cast members a fact names, at the row's end; they come in once the fact is typed. */
.question-part__cast {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 6px;
    margin-top: 1px;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.question-part--typing .question-part__cast {
    opacity: 0;
}

.question-part__role {
    width: 92px;
    margin-top: 1px;
    margin-right: 10px;
    justify-content: center;
}

.question-part__role > .chip__text {
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.question-part__text {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 15px;
    color: var(--muted);
    white-space: normal;
}

/* The one-line lesson of the answered question (the backend's resolution). */
.resolution-rule {
    margin-bottom: 8px;
    padding: 6px 10px;
    border-left-width: 3px;
    border-color: var(--latin);
    background-color: var(--mint-soft);
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--mint-ink);
    white-space: normal;
}

/* The story line before a question, and the one after its answer. */
.story-beat {
    margin-bottom: 8px;
    font-size: 14px;
    -unity-font-style: italic;
    color: var(--brand);
    white-space: normal;
}

.story-outcome {
    margin-bottom: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--heading);
    white-space: normal;
}

/* Chapter and stage of the question; a click shows or hides the scenario paragraph. */
.chapter-chip {
    background-color: var(--gold);
}

.dev-id-chip {
    max-width: 260px;
}

.dev-id-chip:hover {
    background-color: var(--gold);
}

.explanation {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 2px;
    border-color: var(--ink);
}

.explanation__title {
    margin-bottom: 4px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.55px;
    color: var(--brand);
}

.explanation__text {
    font-size: 15px;
    color: var(--muted);
    white-space: normal;
}

/* In the debrief tab the section is all the panel shows, so it needs no separator. */
.explanation--alone {
    margin-top: 0;
    padding-top: 0;
    border-top-width: 0;
}

/* Misconception and answer notes of the debrief; the criteria rows are shared with the criteria modal. */
.debrief-block {
    margin-bottom: 10px;
}

/* The answer notes follow the explanation text, which has no margin of its own. */
#answerNotesSection {
    margin-top: 12px;
}

.misconception {
    font-size: 14px;
    -unity-font-style: italic;
    color: var(--pink-ink);
    white-space: normal;
}

.requirement {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 4px;
}

.requirement__mark {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.requirement__mark--met {
    background-color: var(--mint);
    color: var(--mint-ink);
}

.requirement__mark--missed {
    background-color: var(--pink);
    color: var(--pink-ink);
}

/* An unchecked box: the criteria modal before the question is answered. */
.requirement__mark--empty {
    background-color: var(--white);
}

.requirement__text {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 14px;
    color: var(--heading);
    white-space: normal;
}

.answer-note {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.answer-note__letter {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--ink);
    background-color: var(--peach);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink);
}

.answer-note__letter--correct {
    background-color: var(--mint);
    color: var(--mint-ink);
}

.answer-note__letter--wrong {
    background-color: var(--pink);
    color: var(--pink-ink);
}

.answer-note__text {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

/* At the right of the chip row: the debrief / question switch of an answered question, and the map button. */
.meta-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: auto;
}

.panel-tabs {
    flex-direction: row;
}

.meta-actions .panel-tab {
    margin-left: 6px;
    padding: 3px 11px;
    background-color: var(--cream);
}

.meta-actions .panel-tab:hover {
    background-color: var(--peach-2);
}

.meta-actions .panel-tab--active {
    background-color: var(--ink);
}

.meta-actions .panel-tab--active > .chip__text {
    color: var(--white);
}

.meta-actions > .map-chip {
    background-color: var(--sand);
}

.meta-actions > .map-chip:hover {
    background-color: var(--gold);
}

.meta-actions > .criteria-chip {
    background-color: var(--mint);
}

.meta-actions > .criteria-chip:hover {
    background-color: var(--gold);
}

/* The criteria modal reuses the map overlay's frame; narrower, and its list is not a canvas. */
.criteria .map__wrap {
    width: 640px;
    flex-grow: 0;
}

.criteria__list {
    padding: 12px 14px;
}

.criteria .requirement {
    margin-bottom: 8px;
}

.criteria .requirement__text {
    font-size: 16px;
}

/* Why the last answer or 50/50 request failed; right-aligned in the question's chip row. */
.status-text {
    flex-shrink: 1;
    margin-left: auto;
    padding-left: 12px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--brand);
    white-space: normal;
}

/* ---------- cast: the entities a question and its answers name ---------- */

/* Icon chips for what the question mentions; wraps under the chip row. */
.entity-strip {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.entity-strip--bottom {
    margin-top: 8px;
    margin-bottom: 0;
}

.entity {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 2px 8px 2px 5px;
    margin: 0 6px 6px 0;
    border-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--ink);
}

.entity__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.entity__name {
    margin-left: 5px;
    font-size: 12px;
    -unity-font-style: bold;
}

/* On a card: icons only, the name is the tooltip. */
.entity--compact {
    padding: 3px;
    margin: 0 0 0 4px;
}

.entity--compact > .entity__icon {
    width: 14px;
    height: 14px;
}

.entity--actor { background-color: var(--pink); }
.entity--actor > .entity__icon { -unity-background-image-tint-color: var(--brand); }
.entity--actor > .entity__name { color: var(--pink-ink); }

.entity--object { background-color: var(--mint-soft); }
.entity--object > .entity__icon { -unity-background-image-tint-color: var(--latin); }
.entity--object > .entity__name { color: var(--mint-ink); }

/* Actions, and concepts (a flag, a state, a pattern): what happens rather than what is there. */
.entity--action,
.entity--concept { background-color: var(--sand); }
.entity--action > .entity__icon,
.entity--concept > .entity__icon { -unity-background-image-tint-color: var(--sand-ink); }
.entity--action > .entity__name,
.entity--concept > .entity__name { color: var(--sand-ink); }

/* The one large icon of a question or an answer card: what it is about, always shown. */
.hero-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
}

.hero-icon__image {
    width: 26px;
    height: 26px;
    -unity-background-image-tint-color: var(--brand);
}

.question__icon {
    margin-right: 10px;
    background-color: var(--sand);
}

.question__icon > .hero-icon__image {
    -unity-background-image-tint-color: var(--sand-ink);
}

/* Next to the letter; the auto margin keeps the header's space-between from centring it. Smaller than the
   question's, so the compact card keeps its room for the answer. */
.card__icon {
    width: 32px;
    height: 32px;
    margin-left: 8px;
    margin-right: auto;
}

.card__icon > .hero-icon__image {
    width: 20px;
    height: 20px;
}

.answer-card--correct .card__icon { background-color: var(--mint); }
.answer-card--correct .hero-icon__image { -unity-background-image-tint-color: var(--latin); }
.answer-card--wrong .card__icon { background-color: var(--pink); }
.answer-card--dimmed .hero-icon__image,
.answer-card--eliminated .hero-icon__image { -unity-background-image-tint-color: var(--muted); }

/* Between the icon and the key chip in a card's header. */
.card__entities {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin: 8px 0 4px 0;
}

/* ---------- answer cards ---------- */

/* A fixed height on both sides of a card, so a flip never moves the row; a longer face scrolls in its card.
   The question takes the rest. */
.cards-row {
    flex-shrink: 0;
    height: 300px;
    flex-direction: row;
    padding: 8px 0;
    margin: 12px -10px 8px -10px;
}

.answer-card-slot {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 10px;
}

/* The flip: the card squashes to an edge (flip-out), swaps its face and opens again. USS has no 3D
   rotation, so a horizontal scale stands in for it. */
.answer-card {
    flex-grow: 1;
    transition-property: scale;
    transition-duration: 0.14s;
    transition-timing-function: ease-in-out;
}

.answer-card--flip-out {
    scale: 0 1;
}

/* The back is what the answer leads to; the cast chips describe the option, so they stay on the front. */
.answer-card--back .card__entities {
    display: none;
}

.card__face--back > .card__feedback,
.card__face--back > .card__outcome {
    margin-top: 0;
    padding-top: 0;
    border-top-width: 0;
}

.card__box {
    padding: 10px;
}

.card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.card__letter {
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
}

.card__letter-text {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--brand);
}

.card__answer {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
}

.card__feedback {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: var(--ink);
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

/* Once answered: what the answer leads to in the story (a chip for how well it goes, then the line), why it
   is right or wrong, and what it misses. It takes the feedback's place on the card, so it has the feedback's
   separator. */
.card__outcome {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: var(--ink);
}

.card__impact > .chip__text {
    letter-spacing: 0.55px;
}

.card__impact--success { background-color: var(--mint); }
.card__impact--success > .chip__text { color: var(--mint-ink); }
.card__impact--partial { background-color: var(--gold); }
.card__impact--partial > .chip__text { color: var(--sand-ink); }
.card__impact--failure { background-color: var(--pink); }
.card__impact--failure > .chip__text { color: var(--pink-ink); }

.card__consequence {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--heading);
    white-space: normal;
}

.card__reason {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: italic;
    color: var(--heading);
    white-space: normal;
}

.card__met {
    margin-top: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--latin);
    white-space: normal;
}

.card__gaps {
    margin-top: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--brand);
    white-space: normal;
}

/* Sized to its text, so the card is as tall as its answer; scrolls only when the row's cap cuts it. */
.card__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: auto;
    margin-bottom: 8px;
}

.select-wrap {
    flex-shrink: 0;
    height: 34px;
}

.select-button {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 2px;
    border-radius: 0;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--cream);
    transition-duration: 0.12s;
}

.select-button__text {
    margin-right: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--ink);
}

/* Hover only while the card can still be picked. */
.answer-card--interactive:hover .select-button,
.answer-card--interactive .select-button:hover {
    background-color: var(--brand);
    border-color: var(--ink);
}

.answer-card--interactive .select-button:active {
    background-color: var(--brand-dark);
}

.answer-card--interactive:hover .select-button__text {
    color: var(--white);
}

.answer-card--interactive:hover .icon--select {
    background-image: url("project://database/Assets/UI/PickOne/Icons/select-pointer-light.svg");
}

.answer-card--correct > .card__box {
    background-color: var(--mint-soft);
}

.answer-card--correct .select-button {
    background-color: var(--mint);
}

.answer-card--correct .select-button__text {
    color: var(--mint-ink);
}

.answer-card--wrong > .card__box {
    background-color: var(--pink-soft);
}

.answer-card--wrong .select-button {
    background-color: var(--pink);
}

.answer-card--wrong .select-button__text {
    color: var(--pink-ink);
}

/* A wrong answer that would partly work reads as less wrong than a plain failure. */
.answer-card--wrong.answer-card--impact-partial > .card__box {
    background-color: var(--gold-soft);
}

.answer-card--wrong.answer-card--impact-partial .select-button {
    background-color: var(--gold);
}

.answer-card--wrong.answer-card--impact-partial .select-button__text {
    color: var(--sand-ink);
}

.answer-card--dimmed {
    opacity: 0.8;
}

.answer-card--correct .icon--select,
.answer-card--wrong .icon--select,
.answer-card--dimmed .icon--select {
    display: none;
}

/* ---------- bottom HUD ---------- */

.hud-section {
    flex-shrink: 0;
}

.hud {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 22px;
}

.hud__group {
    flex-direction: row;
    align-items: center;
}

.badge {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    margin-right: 12px;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--ink);
}

.badge--mint {
    background-color: var(--mint);
}

.badge__label {
    margin-right: 8px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.55px;
    color: var(--muted);
}

.badge__text {
    margin-left: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--mint-ink);
}

.hearts {
    flex-direction: row;
}

.hearts > .icon {
    margin-right: 4px;
}

.powerup {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    margin-left: 8px;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--ink);
}

.powerup--button:hover {
    background-color: var(--sand);
}

.powerup--button:disabled {
    background-color: var(--cream);
    opacity: 0.6;
}

.answer-card--eliminated {
    opacity: 0.35;
}

.answer-card--eliminated .icon--select {
    display: none;
}

.action-button {
    height: 40px;
    padding: 0 14px;
    margin: 0 0 0 12px;
    border-radius: 0;
    border-width: 2px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    background-color: var(--gold);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--ink);
}

.action-button:hover {
    background-color: var(--sand);
    border-color: var(--ink);
}

.action-button:disabled {
    background-color: var(--cream);
    color: var(--muted);
    opacity: 0.7;
}

.action-button--primary {
    background-color: var(--brand);
    color: var(--white);
}

.action-button--primary:hover {
    background-color: var(--brand-dark);
}

.powerup__text {
    margin-left: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--ink);
}

.powerup__count {
    margin-left: 8px;
    padding: 1px 7px;
}

.powerup__count > .chip__text {
    font-size: 10px;
}

/* ---------- results overlay ---------- */

.results {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(42, 23, 15, 0.6);
}

.results--hidden {
    display: none;
}

.results__wrap {
    width: 420px;
}

.results__panel {
    align-items: center;
    padding: 32px;
}

.results__title {
    margin-bottom: 8px;
    font-size: 25px;
    -unity-font-style: bold;
    color: var(--heading);
}

.results__score {
    margin-bottom: 24px;
    font-size: 15px;
    color: var(--muted);
}

.results__button-wrap {
    align-self: stretch;
    height: 40px;
}

.primary-button {
    flex-grow: 1;
    margin: 0;
    border-radius: 0;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--brand);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.39px;
    color: var(--white);
}

.primary-button:hover {
    background-color: var(--brand-dark);
    border-color: var(--ink);
}

.primary-button:active {
    background-color: var(--ink);
}

/* ---------- search overlay ---------- */

.search {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding: 88px 0 48px 0;
    background-color: rgba(42, 23, 15, 0.6);
}

.search--hidden {
    display: none;
}

.search__wrap {
    width: 760px;
    flex-shrink: 1;
}

.search__panel {
    padding: 20px 24px 14px 24px;
    overflow: hidden;
}

.search__strip {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 4px;
}

.search__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.search__title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--heading);
}

/* white-space on the field (not only its text) puts its scroll view in vertical mode, so the text wraps. */
.search__input {
    margin: 0;
    white-space: normal;
}

/* Multiline and wrapping, so a pasted question shows whole; it grows to max-height, then scrolls. */
.search__input > .unity-base-text-field__input {
    min-height: 42px;
    max-height: 160px;
    padding: 10px 12px;
    border-radius: 0;
    border-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
    background-color: var(--page);
    font-size: 15px;
    color: var(--ink);
    --unity-cursor-color: var(--ink);
    --unity-selection-color: var(--sand);
}

.search__input .unity-text-element {
    color: var(--ink);
    -unity-text-align: upper-left;
    white-space: normal;
}

.search__input:focus > .unity-base-text-field__input {
    border-color: var(--brand);
    background-color: var(--white);
}

.search__status {
    margin: 10px 0 6px 0;
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

.search__results {
    flex-shrink: 1;
}

.search__hint {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: rgba(224, 191, 186, 0.6);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.33px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

.search-result {
    margin: 0 4px 10px 0;
    padding: 10px 12px;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
}

.search-result:hover {
    background-color: var(--cream);
}

.search-result--selected {
    background-color: var(--pink-soft);
    border-color: var(--brand);
}

.search-result--answered {
    opacity: 0.55;
}

.search-result__meta {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.search-result__meta > .chip {
    margin-right: 6px;
}

.search-result__question {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--heading);
    white-space: normal;
}

.search-result__answers {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.search-result__answer {
    margin: 4px 6px 0 0;
    padding: 2px 8px;
    border-width: 1px;
    border-color: rgba(42, 23, 15, 0.35);
    background-color: var(--page);
    font-size: 12px;
    color: var(--muted);
}

/* ---------- map overlay: the question's flow, or its resolution ---------- */

.map {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding: 48px 0 40px 0;
    background-color: rgba(42, 23, 15, 0.6);
}

.map--hidden {
    display: none;
}

/* Wide enough for four answers side by side under the question. */
.map__wrap {
    width: 1180px;
    flex-grow: 1;
    flex-shrink: 1;
}

.map__panel {
    padding: 20px 24px 14px 24px;
    overflow: hidden;
}

.map__strip {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 4px;
}

.map__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.map__title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--heading);
}

.map__tabs {
    flex-direction: row;
    flex-grow: 1;
    margin-left: 18px;
}

.map__tab {
    margin-right: 6px;
    padding: 3px 11px;
    background-color: var(--cream);
}

.map__tab:hover {
    background-color: var(--peach-2);
}

.map__tab--active {
    background-color: var(--ink);
}

.map__tab--active > .chip__text {
    color: var(--white);
}

.map__header > .icon-button--close {
    margin-left: auto;
}

.map__caption {
    margin-bottom: 10px;
    font-size: 14px;
    -unity-font-style: italic;
    color: var(--muted);
    white-space: normal;
}

.map__scroll {
    flex-grow: 1;
    border-width: 1px;
    border-color: rgba(42, 23, 15, 0.25);
    background-color: var(--page);
}

/* FlowMapView centres it with a left margin while it is narrower than the view; wider, it scrolls. */
.map__canvas {
    flex-shrink: 0;
}

/* Laid out but not shown while its boxes are measured, so they don't flash in a heap. */
.map__canvas--measuring {
    visibility: hidden;
}

.map__empty {
    margin: 24px;
    font-size: 14px;
    color: var(--muted);
}

.map__hint {
    margin-top: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.33px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

/* Painter2D edges, under the boxes; FlowEdgeLayer reads the colours. */
.flow-edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --flow-edge-color: #2a170f;
    --flow-edge-added-color: #326556;
    --flow-edge-muted-color: rgba(88, 65, 61, 0.6);
}

.flow-edge-label {
    position: absolute;
    translate: -50% -50%;
    max-width: 170px;
    padding: 1px 6px;
    border-width: 1px;
    border-color: rgba(42, 23, 15, 0.25);
    background-color: var(--page);
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* One box per step; FlowLayout places it. */
.flow-node {
    position: absolute;
    width: 210px;
    padding: 7px 10px 8px 10px;
    background-color: var(--white);
    border-width: 2px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
}

.flow-node__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.flow-node__glyph {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 5px;
    -unity-background-image-tint-color: var(--muted);
}

.flow-node__tag {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: var(--muted);
}

.flow-node__label {
    font-size: 13px;
    color: var(--heading);
    white-space: normal;
}

.flow-node__cast {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.flow-node__cast > .entity--compact {
    margin: 0 4px 0 0;
}

.flow-node--start,
.flow-node--end {
    border-radius: 14px;
    background-color: var(--mint-soft);
}

.flow-node--decision {
    background-color: var(--gold-soft);
}

/* What comes in and what comes out: a thick left edge, like mermaid's slanted boxes. */
.flow-node--input {
    border-left-width: 6px;
    border-left-color: var(--latin);
}

.flow-node--output {
    border-left-width: 6px;
    border-left-color: var(--gold);
}

.flow-node--human-review {
    background-color: var(--pink-soft);
}

.flow-node--inferred {
    border-color: rgba(42, 23, 15, 0.45);
}

/* The decision the answers hang on. */
.flow-node--question {
    background-color: var(--sand);
    border-color: var(--brand);
}

.flow-node--question .flow-node__tag {
    color: var(--brand);
}

.flow-node--question .flow-node__glyph {
    -unity-background-image-tint-color: var(--brand);
}

/* A step the resolution added: the correct mechanism. */
.flow-node--added {
    background-color: var(--mint);
    border-color: var(--latin);
}

.flow-node--added .flow-node__tag {
    color: var(--latin);
}

.flow-node--added .flow-node__glyph {
    -unity-background-image-tint-color: var(--latin);
}

.flow-node--answer {
    width: 160px;
    background-color: var(--cream);
    border-width: 1px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.flow-node--answer .flow-node__glyph {
    -unity-background-image-tint-color: var(--brand);
}

.flow-node--answer .flow-node__label {
    font-size: 12px;
}

.flow-node--eliminated {
    opacity: 0.35;
}
